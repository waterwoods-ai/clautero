{
  "manifest_version": 2,
  "name": "Clautero",
  "version": "1.0.1",
  "description": "Embed Claude Code as a sidebar AI research assistant in Zotero",
  "author": "tom",
  "homepage_url": "https://github.com/waterwoods-ai/clautero",
  "icons": {
    "48": "content/icons/icon48.svg",
    "96": "content/icons/icon48.svg"
  },
  "applications": {
    "zotero": {
      "id": "clautero@zotero-plugin",
      "update_url": "https://raw.githubusercontent.com/waterwoods-ai/clautero/main/update.json",
      "strict_min_version": "6.999",
      "strict_max_version": "9.*"
    }
  }
}
