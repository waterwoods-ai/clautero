{
  "manifest_version": 2,
  "name": "Clautero",
  "version": "0.1.0",
  "description": "Embed Claude Code as a sidebar AI research assistant in Zotero",
  "author": "tom",
  "homepage_url": "https://github.com/tom/clautero",
  "icons": {
    "48": "content/icons/icon48.png",
    "96": "content/icons/icon96.png"
  },
  "applications": {
    "zotero": {
      "id": "clautero@zotero-plugin",
      "update_url": "https://raw.githubusercontent.com/tom/clautero/main/update.json",
      "strict_min_version": "6.999",
      "strict_max_version": "7.99"
    }
  }
}
